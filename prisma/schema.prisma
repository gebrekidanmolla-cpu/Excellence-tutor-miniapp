generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

enum Gender {
  ANY
  MALE
  FEMALE
}

enum TutorStatus {
  STUDENT
  GRADUATE
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  UNEMPLOYED
  OTHER
}

model Job {
  id      String    @id @default(cuid())
  jobCode String    @unique
  gender  Gender
  grade   String
  subject String
  place   String    @default("")
  salary  Int
  status  JobStatus @default(OPEN)

  // ==========================================
  // JOB SCHEDULE
  // ==========================================

  daysPerWeek Int
  hoursPerDay Float

  // ==========================================
  // ADDITIONAL DETAILS
  // ==========================================

  additionalDetails String? @db.Text

  // ==========================================
  // ASSIGNED TUTOR
  // ==========================================

  assignedTutorId String?

  assignedTutor Tutor? @relation("AssignedJobs", fields: [assignedTutorId], references: [id])

  // ==========================================
  // TIMESTAMPS
  // ==========================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================================
  // RELATIONSHIPS
  // ==========================================

  applications Application[]
}


model Tutor {
  id String @id @default(cuid())

  // ==========================================
  // ACCOUNT INFORMATION
  // ==========================================

  fullName String

  email           String    @unique
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  phone String @unique

  passwordHash String

  // ==========================================
  // PERSONAL INFORMATION
  // ==========================================

  gender Gender

  city String

  subcity String

  exactPlace String

  aboutMe String? @db.VarChar(500)

  // ==========================================
  // CURRENT STATUS
  // ==========================================

  tutorStatus TutorStatus

  // ==========================================
  // STUDENT INFORMATION
  // Only used when tutorStatus = STUDENT
  // ==========================================

  university String?

  department String?

  currentYear String?

  currentGPA Float?

  // ==========================================
  // GRADUATE INFORMATION
  // Only used when tutorStatus = GRADUATE
  // ==========================================

  fieldOfGraduation String?

  universityGraduatedFrom String?

  CGPA Float?

  employmentStatus EmploymentStatus?

  currentJob String?

  // ==========================================
  // ENTRANCE EXAMINATION
  // ==========================================

  entranceScore Int

  entranceTotal Int

  entrancePercentage Float

  // ==========================================
  // DOCUMENTS
  // ==========================================

  transcriptUrl String

  entranceResultUrl String

  graduationDocumentUrl String?

  cvUrl String?

  governmentIdUrl String

  // ==========================================
  // TELEGRAM
  // ==========================================

  telegramId String? @unique

  // ==========================================
  // TIMESTAMPS
  // ==========================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ==========================================
  // RELATIONSHIPS
  // ==========================================

  applications Application[]

  assignedJobs Job[] @relation("AssignedJobs")
}

model EmailVerification {
  id String @id @default(cuid())

  email String

  codeHash String

  expiresAt DateTime

  attempts Int @default(0)

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Application {
  id String @id @default(cuid())

  tutorId String
  jobId   String

  // ==========================================
  // APPLICATION STATUS
  // ==========================================

  status ApplicationStatus @default(PENDING)

  // ==========================================
  // TIMESTAMPS
  // ==========================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ==========================================
  // RELATIONSHIPS
  // ==========================================

  tutor Tutor @relation(fields: [tutorId], references: [id])

  job Job @relation(fields: [jobId], references: [id])

  // ==========================================
  // CONSTRAINTS
  // ==========================================

  @@unique([tutorId, jobId])
  @@index([jobId])
  @@index([tutorId])
  @@index([status])
  @@index([createdAt])
}

model Admin {
  id String @id @default(cuid())

  fullName String

  email String @unique

  passwordHash String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}
