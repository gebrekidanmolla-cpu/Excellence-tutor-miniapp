generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  OPEN
  CLOSED
}

enum TelegramPostStatus {
  PENDING
  POSTED
  FAILED
  DISABLED
}

enum SheetSyncStatus {
  PENDING
  SYNCED
  FAILED
  DISABLED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

enum Gender {
  ANY
  MALE
  FEMALE
}

enum TutorStatus {
  STUDENT
  GRADUATE
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  UNEMPLOYED
  OTHER
}

model Job {
  id      String    @id @default(cuid())
  jobCode String    @unique
  gender  Gender
  grade   String
  subject String
  place   String    @default("")
  salary  Int
  status  JobStatus @default(OPEN)

  // ==========================================
  // PARENT CONTACT
  // ==========================================
  //
  // The parent who requested the tutor, for the admin to follow up
  // with — never shown on the public apply page or the Telegram
  // channel post (`JobForChannelPost` lists its own fields, so this
  // never leaks in just by existing on the row).

  parentName  String @default("")
  parentPhone String @default("")

  // ==========================================
  // JOB SCHEDULE
  // ==========================================

  daysPerWeek Int
  hoursPerDay Float

  // ==========================================
  // ADDITIONAL DETAILS
  // ==========================================

  additionalDetails String? @db.Text

  // ==========================================
  // ASSIGNED TUTOR
  // ==========================================

  assignedTutorId String?

  assignedTutor Tutor? @relation("AssignedJobs", fields: [assignedTutorId], references: [id])

  // ==========================================
  // TELEGRAM PUBLISHING
  // ==========================================
  //
  // The channel post is a side effect of the job, never a
  // precondition: the row is written first and these columns
  // record what happened afterwards, so a Telegram outage can
  // never block job creation.
  //
  // `telegramPostHash` is the sha256 of the rendered text plus
  // the inline keyboard. It makes re-syncing idempotent — an
  // unchanged hash skips the API call entirely, which is also
  // what keeps Telegram's "message is not modified" 400 from
  // firing on every no-op edit.

  telegramChatId     String?
  telegramMessageId  Int?
  telegramPostStatus TelegramPostStatus @default(PENDING)
  telegramPostHash   String?
  telegramPostError  String?            @db.Text
  telegramPostedAt   DateTime?
  telegramSyncedAt   DateTime?

  // In-flight claim, with a TTL rather than a boolean so a request
  // that dies mid-send unblocks itself instead of wedging the job.
  telegramLockedAt   DateTime?

  // ==========================================
  // GOOGLE SHEET MIRROR
  // ==========================================
  //
  // Same side-effect contract as the Telegram columns: written after
  // the job change has committed, recording what happened. `PENDING`
  // means the job has never reached the sheet — every job that
  // predates this column starts there until a "Sync all" backfills it.

  sheetSyncStatus SheetSyncStatus @default(PENDING)
  sheetSyncError  String?         @db.Text
  sheetSyncedAt   DateTime?

  // ==========================================
  // TIMESTAMPS
  // ==========================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================================
  // RELATIONSHIPS
  // ==========================================

  applications Application[]

  @@index([telegramPostStatus])
}


model Tutor {
  id String @id @default(cuid())

  // ==========================================
  // ACCOUNT INFORMATION
  // ==========================================

  fullName String

  email           String    @unique
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  phone String @unique

  passwordHash String

  // ==========================================
  // PERSONAL INFORMATION
  // ==========================================

  gender Gender

  // ==========================================
  // ADDRESS
  // ==========================================
  //
  // `exactPlace` is shown as "Specific area" (4 Kilo, Ayat…).

  country String @default("Ethiopia")

  city String

  subcity String

  exactPlace String

  // Optional second address — e.g. a student's dorm during the week
  // and family home at weekends. All null when not given. See
  // `src/lib/address.ts`.

  address2Country    String?
  address2City       String?
  address2Subcity    String?
  address2ExactPlace String?

  aboutMe String? @db.VarChar(500)

  // ==========================================
  // CURRENT STATUS
  // ==========================================

  tutorStatus TutorStatus

  // ==========================================
  // STUDENT INFORMATION
  // Only used when tutorStatus = STUDENT
  // ==========================================

  university String?

  department String?

  currentYear String?

  currentGPA Float?

  // ==========================================
  // GRADUATE INFORMATION
  // Only used when tutorStatus = GRADUATE
  // ==========================================

  fieldOfGraduation String?

  universityGraduatedFrom String?

  CGPA Float?

  employmentStatus EmploymentStatus?

  currentJob String?

  // ==========================================
  // ENTRANCE EXAMINATION
  // ==========================================

  entranceScore Int

  entranceTotal Int

  entrancePercentage Float

  // ==========================================
  // DOCUMENTS
  // ==========================================

  transcriptUrl String

  entranceResultUrl String

  graduationDocumentUrl String?

  cvUrl String?

  governmentIdUrl String

  // ==========================================
  // TELEGRAM
  // ==========================================

  telegramId String? @unique

  // ==========================================
  // PUBLIC PROFILE LINK
  // ==========================================
  //
  // Random token behind `/tutor-profile/<token>`, the page an admin sends
  // to parents. Null means no link exists. Regenerating it kills the old
  // link, so the column is the revocation switch — never derive it from `id`.
  // A link also dies on its own at `profileShareExpiresAt` (30 days after
  // it was created or reset); a token with no expiry is treated as expired.

  profileShareToken     String?   @unique
  profileShareExpiresAt DateTime?

  // ==========================================
  // TIMESTAMPS
  // ==========================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ==========================================
  // RELATIONSHIPS
  // ==========================================

  applications Application[]

  assignedJobs Job[] @relation("AssignedJobs")
}

model EmailVerification {
  id String @id @default(cuid())

  email String

  codeHash String

  expiresAt DateTime

  attempts Int @default(0)

  verifiedAt DateTime?

  // Who asked for the code — for the per-IP send limit. Null when unknown.
  requestIp String?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@index([requestIp, createdAt])
}

model Application {
  id String @id @default(cuid())

  tutorId String
  jobId   String

  // ==========================================
  // APPLICATION STATUS
  // ==========================================

  status ApplicationStatus @default(PENDING)

  // ==========================================
  // TIMESTAMPS
  // ==========================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ==========================================
  // RELATIONSHIPS
  // ==========================================

  tutor Tutor @relation(fields: [tutorId], references: [id])

  job Job @relation(fields: [jobId], references: [id])

  // ==========================================
  // CONSTRAINTS
  // ==========================================

  @@unique([tutorId, jobId])
  @@index([jobId])
  @@index([tutorId])
  @@index([status])
  @@index([createdAt])
}

model Admin {
  id String @id @default(cuid())

  fullName String

  email String @unique

  passwordHash String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}
