generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  OPEN
  CLOSED
}

enum TelegramPostStatus {
  PENDING
  POSTED
  FAILED
  DISABLED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

enum Gender {
  ANY
  MALE
  FEMALE
}

enum TutorStatus {
  STUDENT
  GRADUATE
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  UNEMPLOYED
  OTHER
}

model Job {
  id      String    @id @default(cuid())
  jobCode String    @unique
  gender  Gender
  grade   String
  subject String
  place   String    @default("")
  salary  Int
  status  JobStatus @default(OPEN)

  // ==========================================
  // PARENT CONTACT
  // ==========================================
  //
  // The parent who requested the tutor, for the admin to follow up
  // with — never shown on the public apply page or the Telegram
  // channel post (`JobForChannelPost` lists its own fields, so this
  // never leaks in just by existing on the row).

  parentName  String @default("")
  parentPhone String @default("")

  // ==========================================
  // JOB SCHEDULE
  // ==========================================

  daysPerWeek Int
  hoursPerDay Float

  // ==========================================
  // ADDITIONAL DETAILS
  // ==========================================

  additionalDetails String? @db.Text

  // ==========================================
  // ASSIGNED TUTOR
  // ==========================================

  assignedTutorId String?

  assignedTutor Tutor? @relation("AssignedJobs", fields: [assignedTutorId], references: [id])

  // ==========================================
  // TELEGRAM PUBLISHING
  // ==========================================
  //
  // The channel post is a side effect of the job, never a
  // precondition: the row is written first and these columns
  // record what happened afterwards, so a Telegram outage can
  // never block job creation.
  //
  // `telegramPostHash` is the sha256 of the rendered text plus
  // the inline keyboard. It makes re-syncing idempotent — an
  // unchanged hash skips the API call entirely, which is also
  // what keeps Telegram's "message is not modified" 400 from
  // firing on every no-op edit.

  telegramChatId     String?
  telegramMessageId  Int?
  telegramPostStatus TelegramPostStatus @default(PENDING)
  telegramPostHash   String?
  telegramPostError  String?            @db.Text
  telegramPostedAt   DateTime?
  telegramSyncedAt   DateTime?

  // In-flight claim, with a TTL rather than a boolean so a request
  // that dies mid-send unblocks itself instead of wedging the job.
  telegramLockedAt   DateTime?

  // ==========================================
  // TIMESTAMPS
  // ==========================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================================
  // RELATIONSHIPS
  // ==========================================

  applications Application[]

  @@index([telegramPostStatus])
}


model Tutor {
  id String @id @default(cuid())

  // ==========================================
  // ACCOUNT INFORMATION
  // ==========================================

  fullName String

  email           String    @unique
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  phone String @unique

  passwordHash String

  // ==========================================
  // PERSONAL INFORMATION
  // ==========================================

  gender Gender

  city String

  subcity String

  exactPlace String

  aboutMe String? @db.VarChar(500)

  // ==========================================
  // CURRENT STATUS
  // ==========================================

  tutorStatus TutorStatus

  // ==========================================
  // STUDENT INFORMATION
  // Only used when tutorStatus = STUDENT
  // ==========================================

  university String?

  department String?

  currentYear String?

  currentGPA Float?

  // ==========================================
  // GRADUATE INFORMATION
  // Only used when tutorStatus = GRADUATE
  // ==========================================

  fieldOfGraduation String?

  universityGraduatedFrom String?

  CGPA Float?

  employmentStatus EmploymentStatus?

  currentJob String?

  // ==========================================
  // ENTRANCE EXAMINATION
  // ==========================================

  entranceScore Int

  entranceTotal Int

  entrancePercentage Float

  // ==========================================
  // DOCUMENTS
  // ==========================================

  transcriptUrl String

  entranceResultUrl String

  graduationDocumentUrl String?

  cvUrl String?

  governmentIdUrl String

  // ==========================================
  // TELEGRAM
  // ==========================================

  telegramId String? @unique

  // ==========================================
  // TIMESTAMPS
  // ==========================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ==========================================
  // RELATIONSHIPS
  // ==========================================

  applications Application[]

  assignedJobs Job[] @relation("AssignedJobs")
}

model EmailVerification {
  id String @id @default(cuid())

  email String

  codeHash String

  expiresAt DateTime

  attempts Int @default(0)

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Application {
  id String @id @default(cuid())

  tutorId String
  jobId   String

  // ==========================================
  // APPLICATION STATUS
  // ==========================================

  status ApplicationStatus @default(PENDING)

  // ==========================================
  // TIMESTAMPS
  // ==========================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ==========================================
  // RELATIONSHIPS
  // ==========================================

  tutor Tutor @relation(fields: [tutorId], references: [id])

  job Job @relation(fields: [jobId], references: [id])

  // ==========================================
  // CONSTRAINTS
  // ==========================================

  @@unique([tutorId, jobId])
  @@index([jobId])
  @@index([tutorId])
  @@index([status])
  @@index([createdAt])
}

model Admin {
  id String @id @default(cuid())

  fullName String

  email String @unique

  passwordHash String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}
