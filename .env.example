# Copy to `.env` and fill in. Never commit the filled copy.

# ==========================================
# DATABASE
# ==========================================
# Postgres connection string. Read by prisma.config.ts and src/lib/prisma.ts.
DIRECT_URL=

# ==========================================
# APP
# ==========================================
# Public base URL, e.g. https://app.example.com. Used for apply links in
# emails and in the Telegram channel post. A localhost value is deliberately
# ignored when building the channel post's button — it would be a dead link
# for every reader.
NEXT_PUBLIC_APP_URL=

# HMAC key for both the tutor and admin session cookies.
SESSION_SECRET=

# ==========================================
# DOCUMENT STORAGE
# ==========================================
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ==========================================
# EMAIL
# ==========================================
RESEND_API_KEY=
EMAIL_FROM=

# ==========================================
# TELEGRAM
# ==========================================
# From @BotFather. Secret — never give this a NEXT_PUBLIC_ prefix.
TELEGRAM_BOT_TOKEN=

# "@publicchannel" or the numeric -100... id. The bot must be an
# administrator of it with "Post messages" and "Edit messages". A numeric id
# is resolved to its public @name automatically for the "View in Telegram"
# link on the job page.
TELEGRAM_CHANNEL_ID=

# Testing only — never set this in production. Lets the channel post's
# Apply Now button point at a local address, so the end-to-end flow can be
# tested against a real channel from a dev machine. Telegram rejects the
# literal hostname "localhost" in a button URL, so it is sent as 127.0.0.1.
TELEGRAM_ALLOW_LOCAL_LINKS=

# ==========================================
# SEED SCRIPT ONLY
# ==========================================
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
