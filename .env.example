# Copy to `.env` and fill in. Never commit the filled copy.

# ==========================================
# DATABASE
# ==========================================
# Postgres connection string. Read by prisma.config.ts and src/lib/prisma.ts.
DIRECT_URL=

# ==========================================
# APP
# ==========================================
# Public base URL, e.g. https://app.example.com. Used for apply links in
# emails and in the Telegram channel post. A localhost value is deliberately
# ignored when building the channel post's button — it would be a dead link
# for every reader.
NEXT_PUBLIC_APP_URL=

# HMAC key for both the tutor and admin session cookies.
SESSION_SECRET=

# ==========================================
# DOCUMENT STORAGE
# ==========================================
# Cloudflare R2 (private bucket; no public access or CORS needed).
# Account ID is in the Cloudflare dashboard sidebar; the key pair comes
# from R2 > Manage API tokens, with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional — defaults to "tutor-documents".
R2_BUCKET=

# Only for the one-off scripts/migrate-documents-to-r2.ts copy from
# the old Supabase bucket. Remove once production has been migrated.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ==========================================
# EMAIL
# ==========================================
RESEND_API_KEY=
EMAIL_FROM=

# ==========================================
# TELEGRAM
# ==========================================
# From @BotFather. Secret — never give this a NEXT_PUBLIC_ prefix.
TELEGRAM_BOT_TOKEN=

# "@publicchannel" or the numeric -100... id. The bot must be an
# administrator of it with "Post messages" and "Edit messages". A numeric id
# is resolved to its public @name automatically for the "View in Telegram"
# link on the job page.
TELEGRAM_CHANNEL_ID=

# Testing only — never set this in production. Lets the channel post's
# Apply Now button point at a local address, so the end-to-end flow can be
# tested against a real channel from a dev machine. Telegram rejects the
# literal hostname "localhost" in a button URL, so it is sent as 127.0.0.1.
TELEGRAM_ALLOW_LOCAL_LINKS=

# ==========================================
# GOOGLE SHEETS (read-only mirror/backup)
# ==========================================
# Workload Identity Federation, not a service-account key — this org's
# iam.disableServiceAccountKeyCreation policy forbids downloading one.
# Vercel signs a short-lived OIDC token into every function invocation
# (VERCEL_OIDC_TOKEN — set automatically on Vercel, or via
# `vercel env pull` / `vercel dev` locally, never set this by hand);
# GCP exchanges it for a token impersonating a service account that
# holds no key of its own. Every var below is a non-secret identifier,
# not a credential. With any of the first five unset the whole feature
# is an inert no-op: jobs still save, and `next build` still succeeds —
# src/lib/google-sheets.ts reads its config per call rather than at
# module load.

# From the sheet's URL: https://docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# The GCP project's numeric project number (not its project ID).
GOOGLE_WIF_PROJECT_NUMBER=

# The Workload Identity Pool ID trusting Vercel's OIDC issuer.
GOOGLE_WIF_POOL_ID=

# The OIDC Provider ID inside that pool.
GOOGLE_WIF_PROVIDER_ID=

# The service account being impersonated — shared on the target sheet
# as an Editor, e.g. sheets-sync@<project-id>.iam.gserviceaccount.com.
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=

# Optional — the sheet's tab name. Defaults to "Sheet1".
GOOGLE_SHEETS_TAB_NAME=

# ==========================================
# SEED SCRIPT ONLY
# ==========================================
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
